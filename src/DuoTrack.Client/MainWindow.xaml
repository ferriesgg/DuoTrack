<Window x:Class="DuoTrack.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DuoTrack" Width="880" Height="830" MinWidth="800" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DuoTrack" FontSize="28" FontWeight="SemiBold" Foreground="#111827" />
                <TextBlock Text="一套键鼠，控制已配对的电脑" Foreground="#6B7280" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="13,7" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="○ 尚未连接" Foreground="#6B7280" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="服务器地址" FontWeight="SemiBold" />
                    <TextBox x:Name="ServerUrlBox" ToolTip="例如 https://duotrack.example.com" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="这台电脑的名称" FontWeight="SemiBold" />
                    <TextBox x:Name="DeviceNameBox" />
                </StackPanel>
                <Button Grid.Column="3" x:Name="SaveButton" Content="保存并连接" Click="SaveAndConnect_Click"
                        VerticalAlignment="Center" Margin="16,18,0,0" Background="#2563EB" Foreground="White" BorderThickness="0" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="我的设备" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <Button Content="刷新" Click="RefreshDevices_Click" DockPanel.Dock="Right" Padding="10,4" MinHeight="28" />
                    </DockPanel>
                    <ListBox Grid.Row="1" x:Name="DevicesList" Margin="0,14,0,12"
                             MinHeight="90"
                             DisplayMemberPath="DisplayText" SelectionChanged="DevicesList_SelectionChanged"
                             FontSize="15" Padding="4" />
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="屏幕布局" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="先选择设备，再点击方位，指定它相对本机的位置。" TextWrapping="Wrap" Foreground="#6B7280" Margin="0,5,0,6" />
                        <Grid Height="146">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="LayoutTop" Grid.Row="0" Grid.Column="1" Content="↑ 上方" Tag="Top" Click="LayoutSide_Click" Padding="4" />
                            <Button x:Name="LayoutLeft" Grid.Row="1" Grid.Column="0" Content="← 左侧" Tag="Left" Click="LayoutSide_Click" Padding="4" />
                            <Border Grid.Row="1" Grid.Column="1" Background="#E5E7EB" CornerRadius="6" Margin="4">
                                <TextBlock Text="本机" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                            <Button x:Name="LayoutRight" Grid.Row="1" Grid.Column="2" Content="右侧 →" Tag="Right" Click="LayoutSide_Click" Padding="4" />
                            <Button x:Name="LayoutBottom" Grid.Row="2" Grid.Column="1" Content="↓ 下方" Tag="Bottom" Click="LayoutSide_Click" Padding="4" />
                        </Grid>
                        <TextBlock x:Name="LayoutDescription" TextWrapping="Wrap" Foreground="#2563EB" Margin="0,4,0,8" />
                        <CheckBox x:Name="EdgeSwitchCheck" Content="像扩展屏一样，用鼠标跨屏切换" Checked="EdgeSwitch_Changed" Unchecked="EdgeSwitch_Changed" />
                        <TextBlock Text="例如远端在右侧：向右跨入，向左跨回，无需点击按钮。" TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <Button x:Name="ControlButton" Content="选择一台在线设备" Click="Control_Click"
                                IsEnabled="False" Background="#2563EB" Foreground="White" BorderThickness="0" />
                        <TextBlock Text="也可以按 Ctrl + Alt + F12 开始或停止控制"
                                   HorizontalAlignment="Center" Foreground="#6B7280" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="添加另一台电脑" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="在一台电脑生成配对码，在另一台输入。配对码 5 分钟内有效。"
                                   TextWrapping="Wrap" Foreground="#6B7280" Margin="0,8,0,12" />
                        <Button x:Name="CreatePairingButton" Content="生成配对码" Click="CreatePairingCode_Click" IsEnabled="False" />
                        <TextBlock x:Name="PairingCodeText" Text="—— ——" FontSize="27" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,8,0,12" Foreground="#111827" />
                        <TextBox x:Name="JoinCodeBox" MaxLength="7" FontSize="18" HorizontalContentAlignment="Center"
                                 ToolTip="输入另一台电脑显示的配对码" />
                        <Button x:Name="JoinPairingButton" Content="使用配对码连接" Click="JoinPairing_Click" IsEnabled="False" />
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="开机自动启动"
                                  Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" />
                        <TextBlock x:Name="DetailStatusText" Text="请先填写服务器地址并连接。"
                                   TextWrapping="Wrap" Foreground="#6B7280" Margin="0,12,0,0" />
                        <TextBlock Text="同一局域网自动优先直连。首次出现防火墙提示时，请允许 DuoTrack 通过专用网络。"
                                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock x:Name="GestureStatusText" TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock x:Name="PerformanceStatusText" TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" />
                        <Button Content="导出滚动诊断" Click="ExportScrollDiagnostics_Click" Margin="0,10,0,0"
                                ToolTip="出现跳动后返回主电脑，在两台电脑分别导出。记录滚动增量和处理耗时，不记录输入文字。" />
                        <CheckBox x:Name="IsolateInjectionCheck" Content="诊断：独立线程注入（重启生效）" Margin="0,12,0,0"
                                  Checked="IsolateInjection_Changed" Unchecked="IsolateInjection_Changed" />
                        <TextBlock x:Name="InjectionModeText" TextWrapping="Wrap" Foreground="#6B7280" FontSize="12" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" Text="关闭窗口后程序仍会留在系统托盘。" Foreground="#9CA3AF"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />
    </Grid>
</Window>
